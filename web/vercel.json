{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/proxy",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/api/mobileconfig",
      "destination": "/api/mobileconfig.js"
    },
    {
      "source": "/mohadarati.mobileconfig",
      "destination": "/mohadarati.mobileconfig"
    },
    {
      "source": "/telegram-cdn/:path*",
      "destination": "https://api.telegram.org/file/:path*"
    },
    {
      "source": "/pdf_viewer.html",
      "destination": "/pdf_viewer.html"
    },
    {
      "source": "/ios_install_guide.mp4",
      "destination": "/ios_install_guide.mp4"
    },
    {
      "source": "/ios_install_guide.gif",
      "destination": "/ios_install_guide.gif"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.mobileconfig",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-aspen-config"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"mohadarati.mobileconfig\""
        }
      ]
    },
    {
      "source": "/api/mobileconfig",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-aspen-config"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"mohadarati.mobileconfig\""
        }
      ]
    },
    {
      "source": "/(index\\.html|main\\.dart\\.js|flutter_bootstrap\\.js|flutter_service_worker\\.js|flutter\\.js|version\\.json|manifest\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
